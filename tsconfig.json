{
  "compilerOptions": {
    "module": "esnext",
    "target": "es2023",
    "types": ["node"],
    "sourceMap": true,
    "declaration": false,
    "declarationMap": false,
    "strict": true,
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "./dist"
  },
  "include": ["src/**/*", "prisma/**/*", "prisma.config.ts"]
}
