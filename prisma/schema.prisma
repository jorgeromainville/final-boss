generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  RECEPCIONISTA
  MEDICO
  GERENCIA
}

enum EstadoCita {
  PROGRAMADA
  COMPLETADA
  CANCELADA
}

model Especialidad {
  id          Int      @id @default(autoincrement())
  nombre      String   @unique
  descripcion String?
  createdAt   DateTime @default(now()) @map("created_at")

  medicos Medico[]

  @@map("especialidades")
}

model Medico {
  id             Int          @id @default(autoincrement())
  nombre         String
  apellido       String
  email          String       @unique
  especialidadId Int          @map("id_especialidad")
  createdAt      DateTime     @default(now()) @map("created_at")

  especialidad Especialidad @relation(fields: [especialidadId], references: [id])
  citas        Cita[]

  @@map("medicos")
}

model Paciente {
  id              Int      @id @default(autoincrement())
  nombre          String
  apellido        String
  email           String   @unique
  fechaNacimiento DateTime @map("fecha_nacimiento")
  createdAt       DateTime @default(now()) @map("created_at")

  citas Cita[]

  @@map("pacientes")
}

model Cita {
  id         Int        @id @default(autoincrement())
  pacienteId Int        @map("id_paciente")
  medicoId   Int        @map("id_medico")
  fechaCita  DateTime   @map("fecha_cita")
  estado     EstadoCita @default(PROGRAMADA)
  motivo     String?
  createdAt  DateTime   @default(now()) @map("created_at")

  paciente Paciente @relation(fields: [pacienteId], references: [id])
  medico   Medico   @relation(fields: [medicoId], references: [id])

  @@map("citas")
}

model Usuario {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  role      Role
  createdAt DateTime @default(now()) @map("created_at")

  @@map("users")
}
